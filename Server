# --- 📦 МОДЕЛИ ДАННЫХ ---
class TelemetryData(BaseModel):
    x: float
    y: float
    z: Optional[float] = 0.0  # Добавили Z
    angle_deg: float
    pitch: Optional[float] = 0.0
    roll: Optional[float] = 0.0
    temp: float
    hum: float
    pressure: float
    mq3: int
    mq6: int
    mq9: int
    battery: Optional[float] = 100.0
    speed: Optional[float] = 0.0
    obstacles: Optional[List[Dict[str, float]]] = None  # Список препятствий: [{"x": float, "y": float, "dist": float, "timestamp": float}]

class CommandData(BaseModel):
    command: str
    params: Optional[Dict] = None  # Добавили параметры, напр. {"target_x": 10, "target_y": 20}

# --- 🔌 API ENDPOINTS ---
@app.post("/api/telemetry")
async def receive_telemetry(data: TelemetryData):
    global robot_state, robot_path, obstacles
    try:
        robot_state.update(data.dict(exclude={"obstacles"}))
        
        # Логика пути (добавляем точку с фильтрацией шума)
        current_pos = {"x": data.x, "y": data.y, "z": data.z or 0.0, "timestamp": time.time()}
        if not robot_path or np.linalg.norm(np.array([robot_path[-1]["x"] - data.x, robot_path[-1]["y"] - data.y])) > 0.05:
            robot_path.append(current_pos)
        
        # Обработка препятствий (добавляем с timestamp, удаляем старые > 60 сек)
        if data.obstacles:
            current_time = time.time()
            obstacles.extend([{"x": o["x"], "y": o["y"], "dist": o.get("dist", 0), "timestamp": current_time} for o in data.obstacles])
            obstacles = [o for o in obstacles if current_time - o["timestamp"] < 60]
        
        return {"status": "synced"}
    except Exception as e:
        logger.error(f"Telemetry error: {e}")
        raise HTTPException(status_code=400, detail=str(e))

@app.get("/api/map_data")
async def get_map_data():
    return {"state": robot_state, "path": list(robot_path), "obstacles": obstacles}

@app.post("/api/move")
async def send_command(data: CommandData):
    global current_command
    current_command = data.command
    command_queue.put(data)  # Добавляем в очередь для обработки
    return {"status": "ok"}

@app.get("/api/get_command")
async def get_command():
    try:
        cmd = command_queue.get_nowait()
        return {"command": cmd.command, "params": cmd.params}
    except queue.Empty:
        return {"command": "stop"}

@app.post("/api/reset")
async def reset_map():
    global robot_path, obstacles
    robot_path.clear()
    obstacles = []
    return {"status": "cleared"}

@app.get("/api/health")
async def health_check():
    return {"status": "healthy", "uptime": time.time() - start_time}

# --- 🎥 ВИДЕО ПОТОК (С АВТО-РЕКОННЕКТОМ И УЛУЧШЕННОЙ ПРОИЗВОДИТЕЛЬНОСТЬЮ) ---
start_time = time.time()
def generate_frames():
    global cap
    frame_counter = 0
    last_annotated_frame = None
    while True:
        try:
            success, frame = cap.read()
            if not success:
                cap.release()
                time.sleep(1)
                cap = cv2.VideoCapture(VIDEO_SOURCE)
                continue
            frame_counter += 1
            
            # YOLO каждые 5 кадров для оптимизации (было 3)
            if frame_counter % 5 == 0:
                results = model(frame, conf=0.5, verbose=False)[0]
                last_annotated_frame = results.plot()
            
            display_frame = last_annotated_frame if last_annotated_frame is not None else frame
            
            # Улучшенное сжатие: адаптивное качество
            quality = 75 if frame_counter % 2 == 0 else 60
            ret, buffer = cv2.imencode('.jpg', display_frame, [int(cv2.IMWRITE_JPEG_QUALITY), quality])
            if not ret: continue
            
            yield (b'--frame\r\n'
                   b'Content-Type: image/jpeg\r\n\r\n' + buffer.tobytes() + b'\r\n')
        except Exception as e:
            logger.error(f"Frame error: {e}")
            time.sleep(1)

@app.get("/video_feed")
async def video_feed():
    return StreamingResponse(generate_frames(), media_type="multipart/x-mixed-replace; boundary=frame")

