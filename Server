            }
            charts.mq3 = initChart('chart-mq3', CONFIG.mq3.color);
            charts.mq6 = initChart('chart-mq6', CONFIG.mq6.color);
            charts.mq9 = initChart('chart-mq9', CONFIG.mq9.color);
            charts.temp = initChart('chart-temp', CONFIG.temp.color);
            charts.hum = initChart('chart-hum', CONFIG.hum.color);
            charts.press = initChart('chart-press', CONFIG.press.color);
            charts.battery = initChart('chart-battery', CONFIG.battery.color);
            // --- УЛУЧШЕННАЯ КАРТА (С ZOOM/PAN) ---
            const mapCanvas = document.getElementById('mapCanvas');
            const mapCtx = mapCanvas.getContext('2d');
            let scale = 20, offsetX = 0, offsetY = 0;
            let isDragging = false, startX, startY;
            mapCanvas.addEventListener('mousedown', (e) => { isDragging = true; startX = e.clientX - offsetX; startY = e.clientY - offsetY; });
            mapCanvas.addEventListener('mousemove', (e) => { if (isDragging) { offsetX = e.clientX - startX; offsetY = e.clientY - startY; } });
            mapCanvas.addEventListener('mouseup', () => isDragging = false);
            mapCanvas.addEventListener('mouseleave', () => isDragging = false);
            mapCanvas.addEventListener('wheel', (e) => { scale *= e.deltaY < 0 ? 1.1 : 0.9; scale = Math.max(5, Math.min(100, scale)); });
            function drawMap(state, path, obstacles) {
                mapCanvas.width = mapCanvas.offsetWidth;
                mapCanvas.height = mapCanvas.offsetHeight;
                const w = mapCanvas.width, h = mapCanvas.height;
                mapCtx.fillStyle = "#090a0c"; mapCtx.fillRect(0,0,w,h);
                mapCtx.strokeStyle = "#1a1a1a"; mapCtx.lineWidth = 1;
                mapCtx.beginPath();
                for(let i=-w; i<w*2; i+=30) { mapCtx.moveTo(i + offsetX % 30, 0); mapCtx.lineTo(i + offsetX % 30, h); }
                for(let i=-h; i<h*2; i+=30) { mapCtx.moveTo(0, i + offsetY % 30); mapCtx.lineTo(w, i + offsetY % 30); }
                mapCtx.stroke();
                mapCtx.save();
                mapCtx.translate(w/2 + offsetX, h/2 + offsetY);
                // Путь с градиентом цвета (новое -> старое)
                mapCtx.lineWidth = 2;
                for(let i=1; i<path.length; i++) {
                    mapCtx.beginPath();
                    mapCtx.strokeStyle = `hsl(180, 100%, ${50 + 50*(i/path.length)}%)`;
                    mapCtx.moveTo(path[i-1].x * scale, -path[i-1].y * scale);
                    mapCtx.lineTo(path[i].x * scale, -path[i].y * scale);
                    mapCtx.stroke();
                }
                // Препятствия с размером по dist
                obstacles.forEach(o => {
                    mapCtx.fillStyle = "#ff003c";
                    mapCtx.beginPath(); 
                    const radius = Math.max(4, o.dist * scale / 10);
                    mapCtx.arc(o.x * scale, -o.y * scale, radius, 0, Math.PI*2); 
                    mapCtx.fill();
                });
                // Робот с ориентацией pitch/roll (простая визуализация)
                mapCtx.translate(state.x * scale, -state.y * scale);
                mapCtx.rotate(state.angle * Math.PI/180);
                mapCtx.fillStyle = "#fff";
                mapCtx.beginPath(); mapCtx.moveTo(0,-8); mapCtx.lineTo(-6,6); mapCtx.lineTo(6,6); mapCtx.fill();
                // Визуализация pitch/roll как наклон
                mapCtx.rotate(state.pitch * Math.PI/180);  // Пример
                mapCtx.restore();
            }
            // --- ГЛАВНЫЙ ЦИКЛ ОБНОВЛЕНИЯ ---
            async function update() {
                try {
                    const res = await fetch('/api/map_data');
                    const data = await res.json();
                    const s = data.state;
                    drawMap(s, data.path, data.obstacles);
                    const updateSensor = (key, val, limit, isLowAlert = false) => {
                        document.getElementById('val-' + key).innerText = val;
                        const chart = charts[key];
                        chart.data.datasets[0].data.push(val);
                        chart.data.datasets[0].data.shift();
                        const card = document.getElementById('card-' + key);
                        const alertCondition = isLowAlert ? (val <= limit) : (val >= limit);
                        if (limit > 0 && alertCondition) {
                            card.classList.add('alert-mode');
                            chart.data.datasets[0].borderColor = '#ff003c';
                        } else {
                            card.classList.remove('alert-mode');
                            chart.data.datasets[0].borderColor = CONFIG[key].color;
                        }
                        chart.update();
                    };
                    updateSensor('mq3', s.mq3, CONFIG.mq3.limit);
                    updateSensor('mq6', s.mq6, CONFIG.mq6.limit);
                    updateSensor('mq9', s.mq9, CONFIG.mq9.limit);
                    updateSensor('temp', s.temp, CONFIG.temp.limit);
                    updateSensor('hum', s.hum, CONFIG.hum.limit);
                    updateSensor('press', s.pressure, 0);
                    updateSensor('battery', s.battery, CONFIG.battery.limit, true);  // Alert if low
                } catch (e) { console.error(e); }
            }
            setInterval(update, 200);  // Увеличили до 5 FPS
            // --- УПРАВЛЕНИЕ WASD + АВТОНОМНЫЙ РЕЖИМ ---
            const keys = {w:'forward', a:'left', s:'backward', d:'right', e:'auto'};
            let activeKey = null;
            document.onkeydown = (e) => {
                const k = e.key.toLowerCase();
                if(keys[k] && activeKey !== k) {
                    activeKey = k;
                    const body = {command: keys[k]};
                    if (k === 'e') body.params = {mode: 'auto_avoid'};  // Пример автономного
                    fetch('/api/move', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)});
                    document.getElementById('cmdText').innerText = keys[k].toUpperCase();
                    document.getElementById('cmdText').style.color = '#00d9ff';
                }
            };
            document.onkeyup = (e) => {
                if(keys[e.key.toLowerCase()]) {
                    activeKey = null;
                    fetch('/api/move', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({command:'stop'})});
                    document.getElementById('cmdText').innerText = "STOP";
                    document.getElementById('cmdText').style.color = "#777";
                }
            };
            async function resetMap() { fetch('/api/reset', {method:'POST'}); }
        </script>
    </body>
