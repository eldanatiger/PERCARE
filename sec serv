import json
import base64
import threading
import time
from io import BytesIO

from flask import Flask, request, jsonify, render_template_string
from PIL import Image

# Initialize Flask app
app = Flask(__name__)

# Global variables to store the latest data
latest_data = {
    "distance": 0.0,
    "humidity": 0.0,
    "temperature": 0.0,
    "water": 0,
    "image_b64": "data:image/png;base64," # Placeholder for an empty image/logo
}

# Lock for thread-safe access to latest_data
data_lock = threading.Lock()

# --- FLASK ROUTES ---

@app.route('/upload', methods=['POST'])
def upload_data():
    """Receives data and image from the Raspberry Pi client."""
    
    # 1. Get Sensor Data (sent as a JSON string in 'json_data' field)
    try:
        json_data = request.form.get('json_data')
        if not json_data:
            return jsonify({"status": "error", "message": "Missing JSON data"}), 400
            
        data = json.loads(json_data)
        
        distance = data.get("distance", 0.0)
        humidity = data.get("humidity", 0.0)
        temperature = data.get("temperature", 0.0)
        water = data.get("water", 0)

    except json.JSONDecodeError:
        return jsonify({"status": "error", "message": "Invalid JSON format"}), 400
    except Exception as e:
        return jsonify({"status": "error", "message": str(e)}), 500

    # 2. Get Image Data (sent as a file in 'image' field)
    image_file = request.files.get('image')
    image_b64 = None
    if image_file:
        try:
            # Read the file data
            img_bytes = image_file.read()
            
            # Convert bytes to base64 string for embedding in HTML
            image_b64 = base64.b64encode(img_bytes).decode('utf-8')
            image_b64_url = f"data:image/jpeg;base64,{image_b64}"
            
        except Exception as e:
            print(f"Error processing image: {e}")
            
    # 3. Update global state
    with data_lock:
        latest_data["distance"] = distance
        latest_data["humidity"] = humidity
        latest_data["temperature"] = temperature
        latest_data["water"] = water
        if image_b64_url:
            latest_data["image_b64"] = image_b64_url

    return jsonify({"status": "success", "message": "Data received successfully"})

@app.route('/data')
def get_latest_data():
    """Endpoint for the frontend to fetch the latest sensor data and image."""
    with data_lock:
        # Return a copy of the latest data
        return jsonify(latest_data.copy())

